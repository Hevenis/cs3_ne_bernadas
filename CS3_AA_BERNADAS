class Plant:
    def __init__(self, name, health, damage):
        self.name = name
        self.health = health
        self.damage = damage

    def attack(self, zombie):
        print(f"{self.name} attacks {zombie.name} for {self.damage} hitpointieessss")
        zombie.take_damage(self.damage)

    def take_damage(self, amount):
        self.health -= amount
        if self.health < 0:
            self.health = 0

    def is_alive(self):
        return self.health > 0


class Zombie:
    def __init__(self, name, health, damage, distance):
        self.name = name
        self.health = health
        self.damage = damage
        self.distance = distance

    def move(self):
        self.distance -= 1
        print(f"{self.name} a step forward... in reference to the direction of the plant btw. Current distance: {self.distance}")

    def attack(self, plant):
        print(f"{self.name} attacks {plant.name} for {self.damage} hitpointiesssssssss")
        plant.take_damage(self.damage)

    def take_damage(self, amount):
        self.health -= amount
        if self.health < 0:
            self.health = 0

    def is_alive(self):
        return self.health > 0


